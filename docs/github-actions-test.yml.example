# Copy this file to .github/workflows/test.yml after enabling credentials that may create GitHub Actions workflows.
name: Test paper-trading research package

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Install project and test dependency
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e . pytest
      - name: Run unit tests
        run: python -m pytest -q
